# Copy to .env for local dev. Do NOT commit a real .env.

# Leave unset to use the bundled SQLite DB at backend/attorney_roadmap.db
# Example for Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/attorney_roadmap

# Comma-separated list of allowed origins, or "*" for dev
FRONTEND_ORIGIN=*

# Local dev port
PORT=5000

# Set to 1 for Flask debug mode locally
FLASK_DEBUG=0

SECRET_KEY=change-me-in-production
